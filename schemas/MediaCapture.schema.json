{
  "additionalProperties": false,
  "properties": {
    "capture_id": {
      "title": "Capture Id",
      "type": "string"
    },
    "block_face_id": {
      "title": "Block Face Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "visit_id": {
      "title": "Visit Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "manual_count",
        "walking_camera",
        "passenger_camera",
        "future_drone",
        "historic_aerial"
      ],
      "title": "Source",
      "type": "string"
    },
    "media_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Path"
    },
    "manual_observation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manual Observation Id"
    },
    "capture_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capture At Utc"
    },
    "capture_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capture Date"
    },
    "time_precision": {
      "default": "unknown",
      "enum": [
        "exact_offset",
        "date_only",
        "local_without_offset",
        "unknown"
      ],
      "title": "Time Precision",
      "type": "string"
    },
    "latitude": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latitude"
    },
    "longitude": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Longitude"
    },
    "geolocation_method": {
      "default": "unknown",
      "enum": [
        "exif_gps",
        "sidecar_gps",
        "confirmed_map_pin",
        "unknown"
      ],
      "title": "Geolocation Method",
      "type": "string"
    },
    "source_received_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Received At Utc"
    },
    "frame_offset_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frame Offset Seconds"
    },
    "visible_fraction": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visible Fraction"
    },
    "occlusion": {
      "items": {
        "enum": [
          "tree",
          "shadow",
          "traffic",
          "other",
          "unmeasured"
