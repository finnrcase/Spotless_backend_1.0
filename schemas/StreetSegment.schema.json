{
  "$defs": {
    "Provenance": {
      "enum": [
        "observed",
        "derived",
        "assumed",
        "imputed",
        "unavailable"
      ],
      "title": "Provenance",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_record_id": {
      "title": "Source Record Id",
      "type": "string"
    },
    "source_version": {
      "title": "Source Version",
      "type": "string"
    },
    "retrieved_at_utc": {
      "format": "date-time",
      "title": "Retrieved At Utc",
      "type": "string"
    },
    "field_provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Field Provenance",
      "type": "object"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "segment_id": {
      "title": "Segment Id",
      "type": "string"
    },
    "geometry_wkt": {
      "title": "Geometry Wkt",
      "type": "string"
    },
    "crs": {
      "const": "EPSG:4326",
      "default": "EPSG:4326",
      "title": "Crs",
      "type": "string"
    },
    "jurisdiction": {
      "const": "City of Los Angeles",
      "default": "City of Los Angeles",
      "title": "Jurisdiction",
      "type": "string"
    },
    "applicability": {
      "enum": [
        "candidate",
        "excluded",
        "needs_review"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "exclusion_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exclusion Reason"
    }
  },
  "required": [
    "source_id",
    "source_record_id",
    "source_version",
    "retrieved_at_utc",
    "field_provenance",
    "confidence",
    "segment_id",
    "geometry_wkt",
    "applicability"
  ],
  "title": "StreetSegment",
  "type": "object"
}