{
  "openapi": "3.1.0",
  "info": {
    "title": "Spotless local parking API",
    "description": "Local City of Los Angeles discovery, full-stay rule checks and experimental sensor-panel forecasts. Unsupported suitability values stay null. Observation imports validate each record and return per-line accepted/rejected results. Example responses in reports/service are from real local datasets; synthetic fixtures stay in temporary tests.",
    "version": "0.2.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Configuration",
