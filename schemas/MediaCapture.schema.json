        "type": "string"
      },
      "title": "Occlusion",
      "type": "array"
    },
    "occupied_visible": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occupied Visible"
    },
    "physical_capacity": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Physical Capacity"
    },
    "legal_capacity": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legal Capacity"
    },
    "legal_capacity_status": {
      "default": "unknown",
      "enum": [
        "verified",
        "uncertain",
        "unknown"
      ],
      "title": "Legal Capacity Status",
      "type": "string"
    },
    "vehicle_class": {
      "default": "standard_passenger",
      "title": "Vehicle Class",
      "type": "string"
    },
    "permit_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Permit Class"
    },
    "intended_duration_minutes": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intended Duration Minutes"
    },
    "restriction_evidence": {
      "default": "",
      "title": "Restriction Evidence",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "privacy_reviewed": {
      "default": false,
      "title": "Privacy Reviewed",
      "type": "boolean"
    },
    "identifiers_present": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identifiers Present"
    },
    "detector_count_candidate": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detector Count Candidate"
    }
  },
  "required": [
    "capture_id",
    "block_face_id",
    "session_id",
    "visit_id",
    "source"
  ],
  "title": "MediaCapture",
  "type": "object"
}