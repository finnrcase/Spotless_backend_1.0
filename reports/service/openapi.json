          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BlockForecast": {
        "properties": {
          "block_face_id": {
            "type": "string",
            "title": "Block Face Id"
          },
          "street_name": {
            "type": "string",
            "title": "Street Name"
          },
          "geometry": {
            "additionalProperties": true,
            "type": "object",
            "title": "Geometry"
          },
          "geometry_method": {
            "type": "string",
            "title": "Geometry Method"
          },
          "straight_line_distance_m": {
            "type": "number",
            "minimum": 0.0,
            "title": "Straight Line Distance M"
          },
          "walking_distance_m": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Walking Distance M"
          },
          "walking_distance_method": {
            "type": "string",
            "title": "Walking Distance Method",
            "default": "centerline_network_estimate; pedestrian crossings/accessibility unverified"
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "rank_reason": {
            "type": "string",
            "title": "Rank Reason"
          },
          "visual_status": {
            "type": "string",
            "enum": [
              "observed_recent",
              "model_estimate",
              "experimental_extrapolation",
              "insufficient_data",
              "known_restriction"
            ],
            "title": "Visual Status"
          },
          "eligibility": {
            "$ref": "#/components/schemas/EligibilityResult"
          },
          "expected_available_eligible_spaces": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Available Eligible Spaces"
          },
          "probability_at_least_one_suitable": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability At Least One Suitable"
          },
          "availability_changes": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Availability Changes"
          },
          "panel_estimate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PanelEstimate"
              },
              {
                "type": "null"
              }
            ]
          },
          "experimental_activity_rank": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Experimental Activity Rank"
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence"
          },
          "uncertainty": {
            "additionalProperties": true,
            "type": "object",
            "title": "Uncertainty"
          },
          "price": {
            "additionalProperties": true,
            "type": "object",
            "title": "Price"
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "block_face_id",
          "street_name",
          "geometry",
          "geometry_method",
          "straight_line_distance_m",
          "rank_reason",
          "visual_status",
          "eligibility",
          "evidence",
          "uncertainty",
          "price"
        ],
        "title": "BlockForecast"
      },
      "EligibilityProfile": {
        "properties": {
          "permit_class": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Permit Class"
          },
          "vehicle_class": {
            "type": "string",
            "enum": [
              "standard_passenger",
              "accessible",
              "commercial",
              "motorcycle",
              "other"
            ],
            "title": "Vehicle Class",
            "default": "standard_passenger"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EligibilityProfile"
      },
      "EligibilityResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unknown",
              "allowed",
              "prohibited",
              "conflict"
            ],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "checked_from": {
            "type": "string",
            "format": "date-time",
            "title": "Checked From"
          },
          "checked_to": {
            "type": "string",
            "format": "date-time",
            "title": "Checked To"
          },
          "official_coverage_complete": {
            "type": "boolean",
            "title": "Official Coverage Complete",
            "default": false
          },
          "posted_sign_coverage_complete": {
            "type": "boolean",
            "title": "Posted Sign Coverage Complete",
            "default": false
          },
          "restrictions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Restrictions"
          },
          "upcoming": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Upcoming"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "reason",
          "checked_from",
          "checked_to"
        ],
        "title": "EligibilityResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Location"
      },
      "ObservationBatch": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/ManualObservation"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records"
        ],
        "title": "ObservationBatch"
      },
      "PanelEstimate": {
        "properties": {
          "occupancy_rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Occupancy Rate"
          },
          "expected_vacant_count": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Vacant Count"
          },
          "probability_any_panel_vacant": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability Any Panel Vacant"
          },
          "panel_sensor_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Panel Sensor Count"
          },
          "count_range": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Count Range"
          },
          "net_change_15m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Net Change 15M"
          },
          "net_change_30m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Net Change 30M"
          },
          "net_change_60m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Net Change 60M"
          },
          "modeled_horizon_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modeled Horizon Minutes"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation",
            "default": "Experimental metered sensor-panel proxy; not full-curb eligible parking"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PanelEstimate"
      },
      "PredictionRequest": {
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/Location"
          },
          "arrival_time": {
            "type": "string",
            "format": "date-time",
            "title": "Arrival Time"
          },
          "intended_stay_minutes": {
            "type": "integer",
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Intended Stay Minutes",
            "default": 60
          },
          "maximum_walking_distance_m": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 25.0,
            "title": "Maximum Walking Distance M",
            "default": 400
          },
          "eligibility": {
            "$ref": "#/components/schemas/EligibilityProfile"
          },
          "maximum_price_per_hour": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maximum Price Per Hour"
          },
          "prefer_lower_price": {
            "type": "boolean",
            "title": "Prefer Lower Price",
            "default": false
          },
          "include_experimental": {
            "type": "boolean",
            "title": "Include Experimental",
            "default": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "live",
              "historical_replay"
            ],
            "title": "Mode",
            "default": "live"
          },
          "replay_issue_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replay Issue Time"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "destination",
          "arrival_time"
        ],
        "title": "PredictionRequest"
      },
      "PredictionResponse": {
        "properties": {
          "request": {
            "$ref": "#/components/schemas/PredictionRequest"
          },
          "forecast_issued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Forecast Issued At"
          },
          "computed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Computed At"
          },
          "response_at": {
            "type": "string",
            "format": "date-time",
            "title": "Response At"
          },
          "arrival_time": {
            "type": "string",
            "format": "date-time",
            "title": "Arrival Time"
          },
          "intended_stay_end": {
            "type": "string",
            "format": "date-time",
            "title": "Intended Stay End"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          },
          "cache_key": {
            "type": "string",
            "title": "Cache Key"
          },
          "data_revision": {
            "type": "string",
            "title": "Data Revision"
          },
          "mode_label": {
            "type": "string",
            "title": "Mode Label"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/BlockForecast"
            },
            "type": "array",
            "title": "Blocks"
          },
          "coverage": {
            "additionalProperties": true,
            "type": "object",
            "title": "Coverage"
          },
          "refresh": {
            "additionalProperties": true,
            "type": "object",
            "title": "Refresh"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request",
          "forecast_issued_at",
          "computed_at",
          "response_at",
          "arrival_time",
          "intended_stay_end",
          "model_version",
          "cache_hit",
          "cache_key",
          "data_revision",
          "mode_label",
          "blocks",
          "coverage",
          "refresh",
          "limitations"
        ],
        "title": "PredictionResponse"
      },
      "RefreshResponse": {
        "properties": {
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Checked At"
          },
          "changed": {
            "type": "boolean",
            "title": "Changed"
          },
          "data_revision": {
            "type": "string",
            "title": "Data Revision"
          },
          "cache_entries_cleared": {
            "type": "integer",
            "title": "Cache Entries Cleared"
          },
          "source_poll_performed": {
            "type": "boolean",
            "title": "Source Poll Performed",
            "default": false
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checked_at",
          "changed",
          "data_revision",
          "cache_entries_cleared",
          "message"
        ],
        "title": "RefreshResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "MeterBayObservation": {
        "additionalProperties": false,
        "properties": {
          "space_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Space Id",
            "type": "string"
          },
          "state": {
