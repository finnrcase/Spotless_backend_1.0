{
  "$defs": {
    "Provenance": {
      "enum": [
        "observed",
        "derived",
        "assumed",
        "imputed",
        "unavailable"
      ],
      "title": "Provenance",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_record_id": {
      "title": "Source Record Id",
      "type": "string"
    },
    "source_version": {
      "title": "Source Version",
      "type": "string"
    },
    "retrieved_at_utc": {
      "format": "date-time",
      "title": "Retrieved At Utc",
      "type": "string"
    },
    "field_provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Field Provenance",
      "type": "object"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "valid_from_utc": {
      "format": "date-time",
      "title": "Valid From Utc",
      "type": "string"
    },
    "valid_to_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To Utc"
    },
    "restriction_id": {
      "title": "Restriction Id",
      "type": "string"
    },
    "block_face_id": {
      "title": "Block Face Id",
      "type": "string"
    },
    "rule_type": {
      "enum": [
        "no_parking",
        "sweeping",
        "permit",
        "loading",
        "time_limit",
        "meter_hours",
        "closure",
        "other"
      ],
      "title": "Rule Type",
      "type": "string"
    },
    "raw_rule_text": {
      "title": "Raw Rule Text",
      "type": "string"
    },
    "local_timezone": {
      "const": "America/Los_Angeles",
      "default": "America/Los_Angeles",
      "title": "Local Timezone",
      "type": "string"
    },
    "schedule": {
      "additionalProperties": true,
      "title": "Schedule",
      "type": "object"
    },
    "permit_eligibility": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Permit Eligibility",
      "type": "array"
    },
    "interpretation_status": {
      "enum": [
        "verified",
        "needs_review",
        "unparsed"
      ],
      "title": "Interpretation Status",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "source_record_id",
    "source_version",
    "retrieved_at_utc",
    "field_provenance",
    "confidence",
    "valid_from_utc",
    "restriction_id",
    "block_face_id",
    "rule_type",
    "raw_rule_text",
    "schedule",
    "interpretation_status"
  ],
  "title": "Restriction",
  "type": "object"
}